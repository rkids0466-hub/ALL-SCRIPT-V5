DarkKnob.BackgroundColor3 = Color3.fromRGB(0, 255, 180)
DarkKnob.BorderSizePixel = 0
DarkKnob.Active = false
DarkKnob.Parent = DarkBar

local DarkKnobCorner = Instance.new("UICorner")
DarkKnobCorner.CornerRadius = UDim.new(1, 0)
