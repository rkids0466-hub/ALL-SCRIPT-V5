local CHAT_TOPIC = "LipzyHubV5_GlobalChat"

local function addChatMessage(username, userId, message, isLocal)
    local msgCard = Instance.new("Frame")
    msgCard.Size = UDim2.new(1, 0, 0, 60)
    msgCard.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    msgCard.BackgroundTransparency = 0.2
    msgCard.Parent = ChatScrollList

    local cardCorner = Instance.new("UICorner")
    cardCorner.CornerRadius = UDim.new(0, 8)
    cardCorner.Parent = msgCard

    local cardStroke = Instance.new("UIStroke")
    cardStroke.Thickness = 1.5
    cardStroke.Color = isLocal and Color3.fromRGB(0, 255, 180) or Color3.fromRGB(100, 100, 100)
    cardStroke.Parent = msgCard

    -- Foto Profil Roblox (Bundar)
    local profileImg = Instance.new("ImageLabel")
    profileImg.Size = UDim2.new(0, 40, 0, 40)
    profileImg.Position = UDim2.new(0, 8, 0, 10)
    profileImg.BackgroundTransparency = 1
    profileImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150"
    profileImg.Parent = msgCard

    local profileCorner = Instance.new("UICorner")
    profileCorner.CornerRadius = UDim.new(1, 0) -- Membuat profil benar-benar bundar
    profileCorner.Parent = profileImg

    -- Username
    local userLabel = Instance.new("TextLabel")
    userLabel.Size = UDim2.new(1, -60, 0, 20)
    userLabel.Position = UDim2.new(0, 55, 0, 8)
    userLabel.BackgroundTransparency = 1
    userLabel.Text = username .. (isLocal and " (Kamu)" or "")
    userLabel.TextColor3 = isLocal and Color3.fromRGB(0, 255, 180) or Color3.fromRGB(255, 255, 255)
    userLabel.TextSize = 14
    userLabel.Font = Enum.Font.FredokaOne
    userLabel.TextXAlignment = Enum.TextXAlignment.Left
    userLabel.Parent = msgCard

    -- Isi Pesan
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -60, 0, 30)
    msgLabel.Position = UDim2.new(0, 55, 0, 26)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = message
    msgLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    msgLabel.TextSize = 14
    msgLabel.Font = Enum.Font.FredokaOne
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.TextWrapped = true
    msgLabel.Parent = msgCard

    -- Auto scroll ke bawah
    task.spawn(function()
        task.wait(0.1)
        ChatScrollList.CanvasPosition = Vector2.new(0, ChatScrollList.AbsoluteCanvasSize.Y)
    end)

    -- Batasi jumlah pesan (max 50) untuk mencegah lag
    local children = ChatScrollList:GetChildren()
    local frameCount = 0
    for _, child in ipairs(children) do
        if child:IsA("Frame") then
            frameCount += 1
            if frameCount > 50 then
                child:Destroy()
            end
        end
    end
end

-- Event saat tombol kirim ditekan
ChatSendBtn.MouseButton1Click:Connect(function()
    local msg = ChatInput.Text
    if msg == "" or msg:match("^%s*$") then return end
    
    local payload = {
        Username = LocalPlayer.Name,
        UserId = LocalPlayer.UserId,
        Message = msg
    }
    
    -- Tampilkan di lokal dulu
    addChatMessage(payload.Username, payload.UserId, payload.Message, true)
    
    -- Publish ke MessagingService agar orang lain di server lain / sama bisa lihat
    pcall(function()
        MessagingService:PublishAsync(CHAT_TOPIC, payload)
    end)
    
    ChatInput.Text = ""
end)

-- Enter untuk kirim
ChatInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        ChatSendBtn.MouseButton1Click:Fire()
    end
end)

-- Subscribe ke MessagingService (Menerima pesan dari pengguna script lain)
pcall(function()
    MessagingService:SubscribeAsync(CHAT_TOPIC, function(data)
        local payload = data.Data
        -- Jangan tampilkan pesan sendiri dua kali
        if payload.UserId ~= LocalPlayer.UserId then
            addChatMessage(payload.Username, payload.UserId, payload.Message, false)
        end
    end)
end)

