    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,
    FogColor = Lighting.FogColor,
    FogEnd = Lighting.FogEnd,
    Brightness = Lighting.Brightness,
}

local function cleanupBloodMoon()
    if bloodEmoteThread then
        pcall(function() task.cancel(bloodEmoteThread) end)
        bloodEmoteThread = nil
    end
    for _, obj in ipairs(bloodParts) do
        pcall(function() obj:Destroy() end)
    end
    table.clear(bloodParts)
    for _, fx in ipairs(bloodEffects) do
        pcall(function() fx:Destroy() end)
    end
    table.clear(bloodEffects)
    pcall(function()
        Lighting.Ambient = originalSkyProps.Ambient
        Lighting.OutdoorAmbient = originalSkyProps.OutdoorAmbient
        Lighting.FogColor = originalSkyProps.FogColor
        Lighting.FogEnd = originalSkyProps.FogEnd
        Lighting.Brightness = originalSkyProps.Brightness
    end)
end

