-- Efek Typing Animation Loop
task.spawn(function()
    local fullText = "LIPZY HUB V5"
    while task.wait(1) do
        for i = 1, #fullText do
            TitleAnim.Text = string.sub(fullText, 1, i)
            task.wait(0.12)
        end
        task.wait(1.5)
        for i = #fullText, 0, -1 do
            TitleAnim.Text = string.sub(fullText, 1, i)
            task.wait(0.06)
        end
    end
end)

