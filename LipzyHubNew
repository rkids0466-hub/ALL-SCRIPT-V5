-- Event Klik Spawn NPC
NpcBtn.MouseButton1Click:Connect(function()
    task.spawn(function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end

        local targetUserId = 7860161471
        pcall(function()
            targetUserId = Players:GetUserIdFromNameAsync("LifzxAfter2")
        end)

        local npcModel
        local successModel, model = pcall(function()
            return Players:CreateHumanoidModelFromUserId(targetUserId)
        end)

        if successModel and model then
            npcModel = model
        else
            npcModel = Instance.new("Model")
            npcModel.Name = "LifzxAfter2"
            local hum = Instance.new("Humanoid")
            hum.Parent = npcModel
        end

        npcModel.Name = "LifzxAfter2"
        npcModel:SetPrimaryPartCFrame(rootPart.CFrame * CFrame.new(0, 0, -5) * CFrame.Angles(0, math.rad(180), 0))
        npcModel.Parent = workspace

        -- Chat Bubble NPC
        local head = npcModel:FindFirstChild("Head")
        if head then
            game:GetService("Chat"):Chat(head, "HELOW " .. LocalPlayer.Name, Enum.ChatColor.Green)
        end

        -- Animation Emote Hai (Wave)
        local humanoid = npcModel:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://507770239"
            local track = humanoid:LoadAnimation(anim)
            track:Play()
        end
    end)
end)

