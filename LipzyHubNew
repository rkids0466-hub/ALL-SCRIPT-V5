    table.insert(bloodParts, avatarModel)

    pcall(function()
        local hum = avatarModel:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.BodyDepthScale = 4
            hum.BodyHeightScale = 4
            hum.BodyWidthScale = 4
            hum.HeadScale = 4
        end
