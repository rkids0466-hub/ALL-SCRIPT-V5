    CardCorner.CornerRadius = UDim.new(0, 12)
    CardCorner.Parent = MsgCard

    local CardStroke = Instance.new("UIStroke")
    CardStroke.Thickness = 2
    CardStroke.Color = Color3.fromRGB(0, 255, 180)
    CardStroke.Parent = MsgCard

    -- Foto Profil Roblox (LifzxAfter2)
    local ProfileImg = Instance.new("ImageLabel")
    ProfileImg.Size = UDim2.new(0, 70, 0, 70)
    ProfileImg.Position = UDim2.new(0, 10, 0, 10)
    ProfileImg.BackgroundTransparency = 1
    
    local success, userId = pcall(function()
        return Players:GetUserIdFromNameAsync("LifzxAfter2")
    end)
    if success and userId then
        ProfileImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150"
    else
        ProfileImg.Image = "rbxassetid://106266705371695"
    end
    ProfileImg.Parent = MsgCard

    local ProfileCorner = Instance.new("UICorner")
    ProfileCorner.CornerRadius = UDim.new(0, 10)
    ProfileCorner.Parent = ProfileImg

    -- Header Title (👑LIPZY HUB👑)
    local HeaderLabel = Instance.new("TextLabel")
    HeaderLabel.Size = UDim2.new(0, 500, 0, 25)
    HeaderLabel.Position = UDim2.new(0, 90, 0, 10)
    HeaderLabel.BackgroundTransparency = 1
    HeaderLabel.Text = "👑LIPZY HUB👑"
    HeaderLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    HeaderLabel.TextSize = 18
    HeaderLabel.Font = Enum.Font.FredokaOne
    HeaderLabel.TextXAlignment = Enum.TextXAlignment.Left
    HeaderLabel.Parent = MsgCard

    -- Isi Pesan
    local ContentLabel = Instance.new("TextLabel")
    ContentLabel.Size = UDim2.new(0, 500, 0, 45)
    ContentLabel.Position = UDim2.new(0, 90, 0, 35)
    ContentLabel.BackgroundTransparency = 1
    ContentLabel.Text = msgText
    ContentLabel.TextColor3 = Color3.fromRGB(80, 255, 180)
    ContentLabel.TextSize = 16
    ContentLabel.Font = Enum.Font.FredokaOne
    ContentLabel.TextXAlignment = Enum.TextXAlignment.Left
    ContentLabel.TextWrapped = true
    ContentLabel.Parent = MsgCard

    -- Suara Admin Abuse
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://9114223280"
    sound.Volume = 1
    sound.Parent = SoundService
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy()
    end)

    -- Auto Hilang setelah 6 detik
    task.delay(6, function()
        if MsgCard and MsgCard.Parent then
            MsgCard:Destroy()
        end
    end)
end

