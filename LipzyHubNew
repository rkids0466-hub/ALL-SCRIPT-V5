-- Slider Logic
local dragging = false

local function updateVolume(input)
    local barPos = SliderBar.AbsolutePosition.X
    local barSize = SliderBar.AbsoluteSize.X
    local mousePos = input.Position.X
    local percent = math.clamp((mousePos - barPos) / barSize, 0, 1)
    
    SliderKnob.Position = UDim2.new(percent, -7, 0.5, -7)
    currentVolume = percent
    if activeSound then
        activeSound.Volume = currentVolume
    end
end

SliderTrigger.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        MainFrame.Draggable = false -- Matikan dragging MainFrame sementara
        updateVolume(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if dragging then
            dragging = false
            MainFrame.Draggable = true -- Kembalikan dragging MainFrame
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateVolume(input)
    end
end)

