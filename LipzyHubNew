local soundEnabled = true
local currentVolume = 0.5
local activeSound = nil

local function playCustomSound(id, isLooped)
    if activeSound then
        activeSound:Stop()
        activeSound:Destroy()
        activeSound = nil
    end

    if not soundEnabled then return end

    local cleanId = tostring(id):gsub("%D", "")
    if cleanId == "" then return end

    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. cleanId
    sound.Volume = currentVolume
    sound.Looped = isLooped or false
    sound.Parent = SoundService
    sound:Play()

    activeSound = sound

    sound.Ended:Connect(function()
        if activeSound == sound then
            activeSound:Destroy()
            activeSound = nil
        end
    end)
end

